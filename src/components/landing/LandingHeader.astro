---
import { SITE_NAME } from "../../consts";

const navLinks = [
	{ href: "#services", label: "Services" },
	{ href: "#forward-deployed", label: "Forward Deployed" },
	{ href: "#process", label: "Process" },
	{ href: "#work", label: "Work" },
	{ href: "#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/95 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
		<a href="#top" class="flex shrink-0 items-center" aria-label={`${SITE_NAME} — book a strategy call`}>
			<img
				src="/logo.png"
				alt={`${SITE_NAME} logo`}
				class="h-12 w-auto rounded-lg"
				width="160"
				height="48"
			/>
		</a>

		<nav class="hidden items-center gap-0.5 lg:flex" aria-label="Landing">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class="rounded-md px-3 py-2 text-sm font-medium text-slate-300 transition hover:bg-white/5 hover:text-white"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href="#book"
				class="hidden shrink-0 rounded-lg border border-white/15 px-4 py-2 text-sm font-semibold text-slate-200 transition hover:bg-white/5 md:inline-block"
			>
				Contact
			</a>
			<a
				href="#book"
				class="hidden shrink-0 rounded-lg bg-violet-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-violet-400 md:inline-block"
			>
				Book a call
			</a>
			<button
				type="button"
				id="landing-menu-toggle"
				class="inline-flex items-center justify-center rounded-lg border border-white/15 p-2 text-slate-200 transition hover:bg-white/5 lg:hidden"
				aria-expanded="false"
				aria-controls="landing-mobile-menu"
				aria-label="Toggle menu"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke-width="2"
					stroke="currentColor"
					class="size-6"
					aria-hidden="true"
				>
					<path id="landing-icon-open" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
					<path id="landing-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</div>

	<div id="landing-mobile-menu" class="hidden border-t border-white/10 bg-slate-950 lg:hidden">
		<nav class="mx-auto max-w-7xl space-y-1 px-4 py-4 sm:px-6" aria-label="Landing mobile">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class="block rounded-lg px-3 py-2.5 text-base font-medium text-slate-200 hover:bg-white/5"
					>
						{link.label}
					</a>
				))
			}
			<a
				href="#book"
				class="mt-2 block rounded-lg bg-violet-500 px-3 py-2.5 text-center text-base font-semibold text-slate-950 transition hover:bg-violet-400"
			>
				Book a call
			</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById("landing-menu-toggle");
	const menu = document.getElementById("landing-mobile-menu");
	const iconOpen = document.getElementById("landing-icon-open");
	const iconClose = document.getElementById("landing-icon-close");

	toggle?.addEventListener("click", () => {
		const expanded = toggle.getAttribute("aria-expanded") === "true";
		toggle.setAttribute("aria-expanded", String(!expanded));
		menu?.classList.toggle("hidden", expanded);
		iconOpen?.classList.toggle("hidden", !expanded);
		iconClose?.classList.toggle("hidden", expanded);
	});

	menu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			menu.classList.add("hidden");
			toggle?.setAttribute("aria-expanded", "false");
			iconOpen?.classList.remove("hidden");
			iconClose?.classList.add("hidden");
		});
	});
</script>