---
import { LANDING_PROJECT_ICONS, type LandingProject } from "../../data/landing-projects";

interface Props {
	project: LandingProject;
}

const { project } = Astro.props;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-950/80 transition-all duration-300 hover:-translate-y-1 hover:border-violet-500/40 hover:shadow-md hover:shadow-violet-950/30">
	<div
		class="relative aspect-[16/10] overflow-hidden border-b border-white/10 bg-gradient-to-b from-slate-900 to-slate-950"
	>
		<div
			class="pointer-events-none absolute inset-0 opacity-[0.12]"
			style="background-image: linear-gradient(to right, rgba(167,139,250,.6) 1px, transparent 1px), linear-gradient(to bottom, rgba(167,139,250,.6) 1px, transparent 1px); background-size: 24px 24px;"
		></div>
		<div
			class="pointer-events-none absolute -inset-10 flex items-center justify-center bg-[radial-gradient(ellipse_at_center,rgba(139,92,246,0.18),transparent_65%)] transition-transform duration-500 group-hover:scale-[1.04]"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 24 24"
				stroke-width="1.5"
				stroke="currentColor"
				class="size-16 text-violet-400/50 transition-colors duration-300 group-hover:text-violet-300"
				aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d={LANDING_PROJECT_ICONS[project.icon]} />
			</svg>
		</div>
		<span
			class="absolute left-4 top-4 rounded-full border border-violet-400/30 bg-slate-950/70 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-violet-300 backdrop-blur"
		>
			{project.tag}
		</span>
	</div>
	<div class="flex flex-1 flex-col p-6">
		<h3 class="text-lg font-semibold leading-snug tracking-tight text-white">{project.title}</h3>
		<p class="mt-1 text-sm font-medium text-violet-400">{project.subtitle}</p>
		<p class="mt-3 text-sm leading-relaxed text-slate-400">{project.description}</p>
	</div>
</article>