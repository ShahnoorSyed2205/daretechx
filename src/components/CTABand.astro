---
import { PHONE_DISPLAY, PHONE_TEL } from "../consts";

interface Props {
	title: string;
	subtitle?: string;
	primaryLabel?: string;
	primaryHref?: string;
	showPhone?: boolean;
}

const {
	title,
	subtitle,
	primaryLabel = "Book a Consultation",
	primaryHref = "/contact",
	showPhone = false,
} = Astro.props;
---

<section class="border-t border-white/10 bg-slate-950 py-16 md:py-20">
	<div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
		<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
		{subtitle && <p class="mt-4 text-lg text-slate-300">{subtitle}</p>}
		<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a
				href={primaryHref}
				class="rounded-lg bg-violet-500 px-6 py-3 text-base font-semibold text-slate-950 transition hover:bg-violet-400"
			>
				{primaryLabel}
			</a>
			{showPhone && (
				<a
					href={`tel:${PHONE_TEL}`}
					class="rounded-lg border border-white/20 px-6 py-3 text-base font-semibold text-white transition hover:bg-white/10"
				>
					Call {PHONE_DISPLAY}
				</a>
			)}
		</div>
	</div>
</section>
