---
import {
	SITE_NAME,
	SITE_TAGLINE,
	SERVICES,
	PHONE_DISPLAY,
	PHONE_TEL,
	EMAIL,
	US_ADDRESS,
} from "../consts";
---

<footer class="bg-slate-950 text-slate-400">
	<div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
		<div>
			<a href="/" class="flex items-center gap-2" aria-label={`${SITE_NAME} home`}>
				<img src="/logo.png" alt={`${SITE_NAME} logo`} class="h-9 w-auto rounded-md" width="120" height="36" />
				<span class="text-base font-bold text-white">{SITE_NAME}</span>
			</a>
			<p class="mt-4 text-sm font-semibold text-violet-300">{SITE_TAGLINE}</p>
			<p class="mt-3 text-sm leading-relaxed">
				We design, build, and protect the AI and software US businesses run on.
			</p>
		</div>

		<div>
			<h3 class="text-sm font-semibold uppercase tracking-wider text-white">Services</h3>
			<ul class="mt-4 space-y-2 text-sm">
				{SERVICES.map((service) => (
					<li>
						<a href={service.href} class="transition hover:text-violet-300">
							{service.shortTitle ?? service.title}
						</a>
					</li>
				))}
			</ul>
		</div>

		<div>
			<h3 class="text-sm font-semibold uppercase tracking-wider text-white">Company</h3>
			<ul class="mt-4 space-y-2 text-sm">
				<li><a href="/" class="transition hover:text-violet-300">Home</a></li>
				<li><a href="/about" class="transition hover:text-violet-300">About</a></li>
				<li><a href="/industries" class="transition hover:text-violet-300">Industries</a></li>
				<li><a href="/contact" class="transition hover:text-violet-300">Contact</a></li>
				<li><a href="/privacy" class="transition hover:text-violet-300">Privacy Policy</a></li>
				<li><a href="/terms" class="transition hover:text-violet-300">Terms of Service</a></li>
			</ul>
		</div>

		<div>
			<h3 class="text-sm font-semibold uppercase tracking-wider text-white">US Office</h3>
			<p class="mt-4 text-sm leading-relaxed">
				{US_ADDRESS.line}
			</p>
			<p class="mt-3 text-sm">
				<a href={`tel:${PHONE_TEL}`} class="transition hover:text-violet-300">{PHONE_DISPLAY}</a>
			</p>
			<p class="mt-1 text-sm">
				<a href={`mailto:${EMAIL}`} class="transition hover:text-violet-300">{EMAIL}</a>
			</p>
		</div>
	</div>

	<div class="border-t border-white/10">
		<div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 py-5 text-xs sm:flex-row sm:px-6">
			<p>© {new Date().getFullYear()} {SITE_NAME}. All rights reserved.</p>
			<div class="flex gap-4">
				<a href="/privacy" class="transition hover:text-violet-300">Privacy Policy</a>
				<a href="/terms" class="transition hover:text-violet-300">Terms of Service</a>
			</div>
		</div>
	</div>
</footer>
