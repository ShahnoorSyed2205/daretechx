---
import { SERVICES } from "../consts";

interface Props {
	slugs: string[];
}

const { slugs } = Astro.props;
const related = SERVICES.filter((s) => slugs.includes(s.slug));
---

<section class="bg-slate-900 py-16 md:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6">
		<h2 class="text-2xl font-bold tracking-tight text-white">Keep exploring</h2>
		<div class="mt-6 flex flex-wrap gap-3">
			<a
				href="/services"
				class="rounded-lg border border-white/15 bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:border-white/40"
			>
				All Services
			</a>
			{
				related.map((service) => (
					<a
						href={service.href}
						class="rounded-lg border border-white/15 bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:border-violet-500 hover:text-violet-400"
					>
						{service.shortTitle ?? service.title}
					</a>
				))
			}
		</div>
	</div>
</section>