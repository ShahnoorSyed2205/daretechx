---
interface Props {
	eyebrow?: string;
	title: string;
	subhead?: string;
	primaryLabel?: string;
	primaryHref?: string;
}

const { eyebrow, title, subhead, primaryLabel, primaryHref = "/contact" } = Astro.props;
---

<section class="bg-slate-950">
	<div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 md:py-28">
		{eyebrow && (
			<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">{eyebrow}</p>
		)}
		<h1 class="mx-auto mt-3 max-w-4xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
			{title}
		</h1>
		{subhead && (
			<p class="mx-auto mt-5 max-w-3xl text-lg text-slate-300">{subhead}</p>
		)}
		{primaryLabel && (
			<div class="mt-8">
				<a
					href={primaryHref}
					class="inline-block rounded-lg bg-violet-500 px-6 py-3 text-base font-semibold text-slate-950 transition hover:bg-violet-400"
				>
					{primaryLabel}
				</a>
			</div>
		)}
	</div>
</section>
