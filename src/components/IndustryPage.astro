---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CTABand from "../components/CTABand.astro";
import { SERVICES } from "../consts";

interface Props {
	industry: string;
	metaTitle: string;
	metaDescription: string;
	challenge: string;
	deliverables: string[];
	whyWorks: string;
	serviceSlugs: string[];
}

const {
	industry,
	metaTitle,
	metaDescription,
	challenge,
	deliverables,
	whyWorks,
	serviceSlugs,
} = Astro.props;

const relatedServices = SERVICES.filter((s) => serviceSlugs.includes(s.slug));
---

<Layout title={metaTitle} description={metaDescription}>
	<PageHero eyebrow="Industries" title={`${industry} Technology Solutions`} primaryLabel="Book a Consultation" />

	<section class="bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-3xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">The Challenge</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					The challenge in {industry.toLowerCase()}
				</h2>
				<p class="mt-5 text-lg leading-relaxed text-slate-400">{challenge}</p>
			</div>
		</div>
	</section>

	<section class="bg-slate-900 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">What We Deliver</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					What we deliver for {industry.toLowerCase()}
				</h2>
			</div>

			<ul class="mt-10 grid gap-4 md:grid-cols-2">
				{
					deliverables.map((item) => (
						<li class="flex items-start gap-3 rounded-xl border border-white/10 bg-slate-950 p-5">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 24 24"
								stroke-width="2"
								stroke="currentColor"
								class="mt-0.5 size-5 shrink-0 text-violet-400"
								aria-hidden="true"
							>
								<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
							</svg>
							<span class="text-slate-300">{item}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Why It Works</p>
					<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
						Built for your constraints.
					</h2>
					<p class="mt-5 text-lg leading-relaxed text-slate-400">{whyWorks}</p>
				</div>
				<div class="rounded-2xl border border-white/10 bg-slate-900 p-8">
					<h3 class="text-lg font-semibold text-white">Relevant services</h3>
					<ul class="mt-4 space-y-3">
						{
							relatedServices.map((service) => (
								<li>
									<a
										href={service.href}
										class="group flex items-center justify-between rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-sm font-semibold text-white transition hover:border-violet-400 hover:text-violet-400"
									>
										{service.title}
										<span class="text-violet-400 transition group-hover:translate-x-0.5">→</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<CTABand title="Need it built inside your industry's constraints?" />
</Layout>