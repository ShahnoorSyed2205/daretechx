---
import { SERVICE_ICONS } from "../consts";

type LogStep = {
	text: string;
	kind: "step" | "success";
};

const steps: LogStep[] = [
	{ text: "Scoping the outcome with your team", kind: "step" },
	{ text: "Embedding senior engineers", kind: "step" },
	{ text: "Building in weekly cycles", kind: "step" },
	{ text: "Security review and hardening", kind: "step" },
	{ text: "Shipped to production — weeks, not quarters", kind: "success" },
];

const stages = ["Scope", "Build", "Ship"];

const chips = [
	{ label: "AI & Automation", icon: SERVICE_ICONS.sparkles, position: "top-1 left-6 sm:left-10", delay: "2.2s" },
	{ label: "Cloud & DevOps", icon: SERVICE_ICONS.cloud, position: "top-1 right-1", delay: "2.8s" },
	{ label: "Cybersecurity", icon: SERVICE_ICONS.shield, position: "bottom-1 right-6 sm:right-12", delay: "3.4s" },
];

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["deploy-console relative px-3 py-8", className]} aria-hidden="true">
	<!-- ambient glow -->
	<div
		class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_60%_40%,rgba(139,92,246,0.22)_0%,rgba(56,189,248,0.08)_45%,transparent_70%)]"
	>
	</div>

	<!-- floating service chips -->
	{
		chips.map((chip) => (
			<div
				class:list={["console-line absolute z-20", chip.position]}
				style={`animation-delay:${chip.delay};`}
			>
				<span
					class="console-chip flex items-center gap-2 rounded-full border border-white/15 bg-slate-900/90 py-1.5 pl-2 pr-3.5 text-xs font-semibold text-slate-200 shadow-lg shadow-black/40 backdrop-blur"
					style={`animation-delay:${chip.delay};`}
				>
					<span class="flex size-6 items-center justify-center rounded-full bg-violet-500/15 text-violet-300">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="1.8"
							stroke="currentColor"
							class="size-3.5"
						>
							<path stroke-linecap="round" stroke-linejoin="round" d={chip.icon} />
						</svg>
					</span>
					{chip.label}
				</span>
			</div>
		))
	}

	<!-- console window -->
	<div
		class="console-line relative z-10 overflow-hidden rounded-2xl border border-white/10 bg-slate-900/80 shadow-2xl shadow-violet-950/60 backdrop-blur-md"
		style="animation-delay:0.1s;"
	>
		<!-- title bar -->
		<div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
			<span class="size-2.5 rounded-full bg-rose-400/70"></span>
			<span class="size-2.5 rounded-full bg-amber-400/70"></span>
			<span class="size-2.5 rounded-full bg-emerald-400/70"></span>
			<span class="ml-2 font-mono text-xs text-slate-500">forward-deploy.log</span>
			<span
				class="ml-auto flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-widest text-emerald-300"
			>
				<span class="size-1.5 rounded-full bg-emerald-400"></span>
				Live
			</span>
		</div>

		<!-- deploy log -->
		<div class="space-y-2.5 p-5 font-mono text-xs leading-relaxed sm:text-sm">
			<p class="console-line" style="animation-delay:0.4s;">
				<span class="text-violet-400">$</span>
				<span class="text-slate-100">daretechx deploy</span>
				<span class="text-sky-400">--mode forward</span>
			</p>
			{
				steps.map((step, i) =>
					step.kind === "step" ? (
						<p
							class="console-line flex items-baseline justify-between gap-4"
							style={`animation-delay:${0.9 + i * 0.45}s;`}
						>
							<span class="text-slate-300">
								<span class="mr-1.5 text-violet-400">▸</span>
								{step.text}
							</span>
							<span class="shrink-0 text-emerald-400">done</span>
						</p>
					) : (
						<p
							class="console-line -mx-2 rounded-lg border border-emerald-400/20 bg-emerald-400/5 px-2 py-1.5 font-semibold text-emerald-300"
							style={`animation-delay:${0.9 + i * 0.45}s;`}
						>
							<span class="mr-1.5">✓</span>
							{step.text}
						</p>
					),
				)
			}
			<p class="console-line" style="animation-delay:3.2s;">
				<span class="text-violet-400">$</span>
				<span class="console-cursor ml-1 inline-block h-3.5 w-2 translate-y-0.5 bg-sky-300"></span>
			</p>
		</div>

		<!-- pipeline progress -->
		<div class="border-t border-white/10 px-5 py-4">
			<div class="grid grid-cols-3 gap-3">
				{
					stages.map((stage, i) => (
						<div>
							<div class="h-1 overflow-hidden rounded-full bg-white/5">
								<div
									class="console-bar h-full w-full bg-gradient-to-r from-sky-400 to-violet-500"
									style={`animation-delay:${1.1 + i * 0.6}s;`}
								/>
							</div>
							<p class="mt-1.5 font-mono text-[10px] uppercase tracking-widest text-slate-500">
								{stage}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</div>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.console-line {
			opacity: 0;
			transform: translateY(6px);
			animation: console-line-in 0.5s ease-out forwards;
		}

		.console-bar {
			transform: scaleX(0);
			transform-origin: left;
			animation: console-bar-fill 0.9s ease-out forwards;
		}

		.console-chip {
			animation: console-chip-float 6s ease-in-out infinite;
		}

		.console-cursor {
			animation: console-blink 1.1s steps(2, start) infinite;
		}
	}

	@keyframes console-line-in {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes console-bar-fill {
		to {
			transform: scaleX(1);
		}
	}

	@keyframes console-chip-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-7px);
		}
	}

	@keyframes console-blink {
		50% {
			opacity: 0;
		}
	}
</style>
