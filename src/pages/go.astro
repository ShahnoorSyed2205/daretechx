---
import Layout from "../layouts/Layout.astro";
import ShowcaseHero from "../components/ShowcaseHero.astro";
import FAQSection from "../components/FAQSection.astro";
import LandingHeader from "../components/landing/LandingHeader.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
import ProjectCard from "../components/landing/ProjectCard.astro";
import { LANDING_PROJECTS } from "../data/landing-projects";
import { SITE_NAME, PHONE_DISPLAY, PHONE_TEL, EMAIL, US_ADDRESS, SERVICE_ICONS } from "../consts";

const landingServices = [
	{
		title: "Forward Deployed AI Engineering",
		line: "Senior engineers embedded in your team, working your problem inside your stack.",
		icon: "rocket",
	},
	{
		title: "AI Automation",
		line: "Replace manual, repetitive operations with reliable AI workflows that cut cost.",
		icon: "sparkles",
	},
	{
		title: "Custom Software Development",
		line: "Web, mobile, and SaaS platforms built to your business logic, ready to scale.",
		icon: "code",
	},
	{
		title: "Cybersecurity",
		line: "Security reviews, hardening, and monitoring that satisfy compliance.",
		icon: "shield",
	},
	{
		title: "Cloud and DevOps",
		line: "Cloud architecture and CI/CD pipelines that make releases fast and safe.",
		icon: "cloud",
	},
	{
		title: "Data Engineering",
		line: "Pipelines and clean data foundations for reporting and AI you can trust.",
		icon: "chart",
	},
];

const forwardPoints = [
	{ title: "Embedded, not outsourced.", line: "Our engineers work as part of your team." },
	{ title: "Senior only.", line: "People who have shipped hard systems before." },
	{ title: "US overlap.", line: "A Maryland base and aligned hours." },
	{ title: "Fixed scope, clear pricing.", line: "You know what ships and what it costs before we start." },
];

const compareRows = [
	{ label: "Senior engineers only", us: "Yes", typical: "No" },
	{ label: "US timezone overlap", us: "Yes", typical: "No" },
	{ label: "Embedded in your team", us: "Yes", typical: "No" },
	{ label: "Full stack under one roof", us: "Yes", typical: "No" },
	{ label: "First ship in weeks", us: "Yes", typical: "No" },
	{ label: "Cheap hourly rate", us: "By value", typical: "Yes" },
];

const processSteps = [
	{
		num: "01",
		title: "Deploy",
		line: "We map your goal, agree scope and price, then place the right senior team into your workflow within days.",
	},
	{
		num: "02",
		title: "Build",
		line: "We ship in short cycles with working software you can see every week.",
	},
	{
		num: "03",
		title: "Scale",
		line: "We harden, document, and hand over, or stay embedded as you grow.",
	},
];

const trustStats = [
	{ value: "5 regions", label: "Global footprint" },
	{ value: "Senior only", label: "No junior handoffs" },
	{ value: "Weeks", label: "Time to first ship" },
];

const faqs = [
	{
		question: "How is DareTechX different from an offshore development shop?",
		answer:
			"Offshore shops sell cheap hours behind a wall. We deploy senior engineers into your team, in your timezone, owning the outcome. You buy a result, not a headcount.",
	},
	{
		question: "How fast can you start?",
		answer:
			"Most engagements begin within days of an agreed scope. First working software typically lands in weeks.",
	},
	{
		question: "Do you work in US business hours?",
		answer:
			"Yes. Our Maryland base gives you a local contact and real timezone overlap.",
	},
	{
		question: "What size of company do you work with?",
		answer:
			"Funded startups scaling their product and established companies modernising their systems.",
	},
	{
		question: "How do you price engagements?",
		answer: "By scope and value, agreed up front. No surprise hourly creep.",
	},
	{
		question: "Who owns the code and IP?",
		answer: "You do. Everything we build is yours, delivered clean and documented.",
	},
];

const professionalServiceSchema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: SITE_NAME,
	url: "https://daretechx.com/go",
	telephone: PHONE_TEL,
	email: EMAIL,
	address: {
		"@type": "PostalAddress",
		streetAddress: US_ADDRESS.street,
		addressLocality: US_ADDRESS.city,
		addressRegion: US_ADDRESS.state,
		postalCode: US_ADDRESS.zip,
		addressCountry: US_ADDRESS.country,
	},
	geo: {
		"@type": "GeoCoordinates",
		latitude: 38.7079,
		longitude: -77.003,
	},
	openingHours: "Mo-Fr 09:00-18:00",
	areaServed: "US",
	parentOrganization: {
		"@type": "Organization",
		name: SITE_NAME,
		url: "https://daretechx.com",
	},
};
---

<Layout
	title="Forward Deployed AI Engineering for US Companies | DareTechX"
	description="Senior AI and software teams deployed into your business, shipping in weeks not quarters. Book a strategy call."
	schema={[professionalServiceSchema]}
	hideChrome
>
	<LandingHeader />

	<ShowcaseHero
		id="top"
		badge="Forward Deployed AI Engineering"
		title="Senior AI and software teams, deployed into your business,"
		highlight="shipping in weeks not quarters."
		description="DareTechX builds AI automation, custom software, and secure cloud systems for US companies that need serious engineering without the cost and delay of hiring in house."
		primaryCta={{ href: "#book", label: "Book a strategy call" }}
		secondaryCta={{ href: "#services", label: "See what we build" }}
		keywords={["Lanham, MD", "Senior-only teams", "Shipping in weeks"]}
	/>

	<section class="border-b border-white/10 bg-slate-900 py-10">
		<div class="mx-auto max-w-7xl px-4 text-center sm:px-6">
			<p class="text-sm font-medium uppercase tracking-widest text-slate-400">
				Delivering across UK, USA, Canada, UAE, Europe
			</p>
			<div class="mt-8 grid gap-8 sm:grid-cols-3">
				{
					trustStats.map((stat) => (
						<div>
							<p class="text-2xl font-extrabold tracking-tight text-white">{stat.value}</p>
							<p class="mt-1 text-sm text-slate-400">{stat.label}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="services" class="scroll-mt-20 bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Services</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Six capabilities, one accountable team.
				</h2>
			</div>

			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					landingServices.map((service) => (
						<div class="group rounded-2xl border border-white/10 bg-slate-950/80 p-6 transition hover:-translate-y-1 hover:border-violet-500/40">
							<div
								class="flex size-11 items-center justify-center rounded-lg bg-white/5 text-violet-400 transition group-hover:bg-violet-500 group-hover:text-slate-950"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke-width="1.8"
									stroke="currentColor"
									class="size-6"
									aria-hidden="true"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d={SERVICE_ICONS[service.icon]} />
								</svg>
							</div>
							<h3 class="mt-5 text-lg font-semibold text-white">{service.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{service.line}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="forward-deployed" class="scroll-mt-20 bg-slate-900 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">The Model</p>
					<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
						We do not send you a ticket queue. We send you a team.
					</h2>
					<p class="mt-5 text-lg leading-relaxed text-slate-400">
						Most software shops sell you hours behind a wall. We place senior engineers
						directly alongside your people, in your timezone, owning outcomes end to end.
					</p>
					<ul class="mt-8 space-y-4">
						{
							forwardPoints.map((point) => (
								<li class="flex items-start gap-3">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										fill="none"
										viewBox="0 0 24 24"
										stroke-width="2"
										stroke="currentColor"
										class="mt-0.5 size-5 shrink-0 text-violet-400"
										aria-hidden="true"
									>
										<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
									</svg>
									<p class="text-slate-300">
										<span class="font-semibold text-white">{point.title}</span> {point.line}
									</p>
								</li>
							))
						}
					</ul>
				</div>

				<div class="rounded-2xl border border-white/10 bg-slate-950/80 p-6 sm:p-8">
					<h3 class="text-lg font-semibold text-white">DareTechX vs. the typical shop</h3>
					<table class="mt-6 w-full text-sm">
						<thead>
							<tr class="border-b border-white/10 text-left">
								<th class="pb-3 pr-4 font-semibold text-slate-400">Consideration</th>
								<th class="pb-3 pr-4 font-semibold text-violet-400">DareTechX</th>
								<th class="pb-3 font-semibold text-slate-400">Typical</th>
							</tr>
						</thead>
						<tbody>
							{
								compareRows.map((row) => (
									<tr class="border-b border-white/5">
										<td class="py-3 pr-4 text-slate-300">{row.label}</td>
										<td class="py-3 pr-4 font-semibold text-white">{row.us}</td>
										<td class="py-3 text-slate-500">{row.typical}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</section>

	<section id="process" class="scroll-mt-20 bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Process</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					From first call to shipped systems.
				</h2>
			</div>

			<div class="mt-12 grid gap-6 md:grid-cols-3">
				{
					processSteps.map((step) => (
						<div class="rounded-2xl border border-white/10 bg-slate-900 p-6">
							<p class="text-3xl font-extrabold text-violet-400">{step.num}</p>
							<h3 class="mt-3 text-lg font-semibold text-white">{step.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{step.line}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="work" class="scroll-mt-20 bg-slate-900 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Selected projects</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Technology We've Built
				</h2>
				<p class="mt-5 text-lg leading-relaxed text-slate-400">
					Real digital solutions designed around real business challenges.
				</p>
			</div>

			<div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				{LANDING_PROJECTS.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>

	<section id="presence" class="scroll-mt-20 bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-3xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">US Presence</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					A US base, a global engineering bench. One accountable partner, delivery that does not sleep.
				</h2>
			</div>

			<div class="mt-12 grid gap-6 md:grid-cols-2">
				<div class="rounded-2xl border border-white/10 bg-slate-900 p-8">
					<h3 class="text-lg font-semibold text-white">US Office</h3>
					<p class="mt-2 text-violet-400">Lanham, Maryland</p>
					<p class="mt-3 text-slate-400">
						Your local point of contact and delivery lead.
					</p>
					<p class="mt-4 text-sm text-slate-500">{US_ADDRESS.line}</p>
				</div>
				<div class="rounded-2xl border border-white/10 bg-slate-900 p-8">
					<h3 class="text-lg font-semibold text-white">How we deliver</h3>
					<p class="mt-2 text-violet-400">Senior engineers, embedded</p>
					<p class="mt-3 text-slate-400">
						One accountable partner from the first line of code to production, owning
						the outcome end to end.
					</p>
				</div>
			</div>
		</div>
	</section>

	<div id="faq" class="scroll-mt-20">
		<FAQSection faqs={faqs} />
	</div>

	<section id="book" class="scroll-mt-20 bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
			<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Book a call</p>
			<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Pick a time. We will scope your problem live.
			</h2>
			<p class="mx-auto mt-5 max-w-2xl text-lg text-slate-400">
				A 30 minute call to map your outcome and show you what a forward deployed team
				would do about it.
			</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
				<a
					href="/contact"
					class="rounded-lg bg-violet-500 px-6 py-3 text-base font-semibold text-slate-950 transition hover:bg-violet-400"
				>
					Book a strategy call
				</a>
				<a
					href={`mailto:${EMAIL}`}
					class="rounded-lg border border-white/20 px-6 py-3 text-base font-semibold text-white transition hover:bg-white/10"
				>
					Email {EMAIL}
				</a>
				<a
					href={`tel:${PHONE_TEL}`}
					class="rounded-lg border border-white/20 px-6 py-3 text-base font-semibold text-white transition hover:bg-white/10"
				>
					Call {PHONE_DISPLAY}
				</a>
			</div>
			<p class="mt-6 text-sm text-slate-500">
				Book a call from the contact form and pick a date and time that suits you.
			</p>
		</div>
	</section>

	<LandingFooter />
</Layout>