---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTABand from "../components/CTABand.astro";
import { SERVICES } from "../consts";
---

<Layout
	title="Services | AI, Software, Cybersecurity, Cloud | DareTechX USA"
	description="DareTechX delivers forward deployed AI engineering, AI automation, custom software, cybersecurity, cloud, and data services for US businesses. Explore what we build."
>
	<section class="bg-slate-950">
		<div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 md:py-28">
			<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Services</p>
			<h1 class="mt-3 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
				What We Build
			</h1>
			<p class="mx-auto mt-5 max-w-3xl text-lg text-slate-300">
				One team across the full stack of modern delivery. AI, software, security, cloud,
				and data — built, deployed, and secured by engineers who own the outcome.
			</p>
		</div>
	</section>

	<section class="bg-slate-900 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
					One team across the full stack of modern delivery.
				</h2>
				<p class="mt-4 text-lg leading-relaxed text-slate-400">
					Most vendors hand your project across three agencies and a support desk. We
					keep one team accountable from the first line of code to live in production —
					with security and measurable outcomes built in along the way.
				</p>
			</div>

			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{SERVICES.map((service) => <ServiceCard service={service} />)}
			</div>
		</div>
	</section>

	<CTABand
		title="Not sure where to start?"
		subtitle="Book a consultation and we will point you to the right lane."
	/>
</Layout>