---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import FAQSection from "../../components/FAQSection.astro";
import CTABand from "../../components/CTABand.astro";
import RelatedServices from "../../components/RelatedServices.astro";

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	serviceType: "Data Engineering & Analytics",
	provider: {
		"@type": "Organization",
		name: "DareTechX",
		url: "https://daretechx.com",
	},
	url: "https://daretechx.com/services/data-engineering",
	areaServed: "US",
	description:
		"Clean data pipelines, warehouses, and dashboards that turn scattered data into decisions.",
};

const builds = [
	{
		title: "Data pipelines",
		description:
			"Reliable flows that pull your data together from every source.",
	},
	{
		title: "Warehousing",
		description:
			"A single, clean source of truth instead of ten conflicting spreadsheets.",
	},
	{
		title: "Dashboards & BI",
		description:
			"Live views of the numbers that actually run your business.",
	},
];

const faqs = [
	{
		question: "Our data is messy and everywhere. Can you still help?",
		answer:
			"Yes. Consolidating messy, scattered data is exactly the job.",
	},
	{
		question: "Does this connect to AI work?",
		answer: "Directly. Clean data is what makes reliable AI possible.",
	},
];
---

<Layout
	title="Data Engineering & Analytics Services | Pipelines & Dashboards"
	description="Turn scattered data into decisions. DareTechX builds clean data pipelines, warehouses, and dashboards that give your team answers, not spreadsheets. US delivery."
	schema={[serviceSchema]}
>
	<PageHero
		eyebrow="Service"
		title="Data Engineering & Analytics"
		subhead="Clean pipelines and clear dashboards that turn scattered data into decisions your team can act on."
		primaryLabel="Book a Consultation"
	/>

	<section class="bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">What We Build</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					From raw data to real answers.
				</h2>
			</div>

			<div class="mt-12 grid gap-6 md:grid-cols-3">
				{
					builds.map((item) => (
						<div class="rounded-2xl border border-white/10 bg-slate-900 p-6">
							<h3 class="text-lg font-semibold text-white">{item.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{item.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-slate-900 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-3xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Why It Matters</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					You cannot act on data you cannot see.
				</h2>
				<p class="mt-5 text-lg leading-relaxed text-slate-400">
					Most businesses are sitting on valuable data trapped in disconnected tools. We
					connect it, clean it, and put it in front of you in a form you can use, which
					is also the groundwork that makes AI and automation possible later.
				</p>
			</div>
		</div>
	</section>

	<FAQSection faqs={faqs} />

	<CTABand title="Sitting on data you cannot use? Let's unlock it." />

	<RelatedServices slugs={["ai-automation", "cloud-devops"]} />
</Layout>
