---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import FAQSection from "../../components/FAQSection.astro";
import CTABand from "../../components/CTABand.astro";
import RelatedServices from "../../components/RelatedServices.astro";

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	serviceType: "AI & Automation Solutions",
	provider: {
		"@type": "Organization",
		name: "DareTechX",
		url: "https://daretechx.com",
	},
	url: "https://daretechx.com/services/ai-automation",
	areaServed: "US",
	description:
		"Custom AI chatbots, copilots, and workflow automation trained on your business data.",
};

const builds = [
	{
		title: "Chatbots & copilots",
		description:
			"Trained on your own data, answering customers and helping staff, not generic tools.",
	},
	{
		title: "Workflow automation",
		description:
			"Connect your CRM, email, docs, and tools so tasks run without a human pushing them.",
	},
	{
		title: "Document & data automation",
		description: "Extract, sort, and process paperwork and data at machine speed.",
	},
];

const delivery = [
	"Discover the process to remove",
	"Design the automation",
	"Build and integrate",
	"Test and deploy",
	"Measure the time and cost saved",
];

const tools = [
	"GPT and Claude",
	"LangChain",
	"RAG on private data",
	"Vector databases",
	"n8n and Make for automation",
	"Secure API integration into your existing tools",
];

const faqs = [
	{
		question: "Will this replace my staff?",
		answer:
			"It removes the repetitive work so your staff focus on what matters. Most clients redeploy time, not people.",
	},
	{
		question: "Can it use our own data?",
		answer:
			"Yes. That is the point. We ground the AI in your data so answers are accurate and specific to you.",
	},
	{
		question: "How do you keep our data safe?",
		answer:
			"Security and access controls are built in from the start. See our Cybersecurity services.",
	},
];
---

<Layout
	title="AI & Automation Solutions | Chatbots, Copilots, Workflow AI"
	description="Custom AI chatbots, copilots, and workflow automation trained on your business data. DareTechX builds AI that cuts manual work and scales with you. US delivery."
	schema={[serviceSchema]}
>
	<PageHero
		eyebrow="Service"
		title="AI & Automation Solutions"
		subhead="Custom chatbots, internal copilots, and automation that pull manual work out of your business and give your team its time back."
		primaryLabel="Book a Consultation"
	/>

	<section class="bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">What We Build</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					AI wired into how you work.
				</h2>
			</div>

			<div class="mt-12 grid gap-6 md:grid-cols-3">
				{
					builds.map((item) => (
						<div class="rounded-2xl border border-white/10 bg-slate-900 p-6">
							<h3 class="text-lg font-semibold text-white">{item.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{item.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-slate-900 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-3xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">The Payoff</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Automation that shows up on the bottom line.
				</h2>
				<p class="mt-5 text-lg leading-relaxed text-slate-400">
					Every manual, repetitive task is cost and delay. We find the processes eating
					your team's hours and replace them with AI that runs quietly in the background.
					The goal is simple: fewer hours on busywork, faster response times, and systems
					that scale without new headcount.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">How We Deliver</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					A clear path from process to payoff.
				</h2>
			</div>

			<ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
				{
					delivery.map((step, index) => (
						<li class="rounded-2xl border border-white/10 bg-slate-900 p-6">
							<p class="text-3xl font-extrabold text-violet-400">
								{String(index + 1).padStart(2, "0")}
							</p>
							<p class="mt-3 font-semibold text-white">{step}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="bg-slate-900 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Tools & Stack</p>
					<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
						The stack we build on.
					</h2>
					<p class="mt-4 text-lg text-slate-300">
						Best-in-class models and platforms, wired into your tools securely.
					</p>
				</div>
				<ul class="flex flex-wrap gap-3">
					{
						tools.map((tool) => (
							<li class="rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-200">
								{tool}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<FAQSection faqs={faqs} />

	<CTABand title="Tell us the process you want gone." />

	<RelatedServices slugs={["forward-deployed-engineering", "custom-software-development"]} />
</Layout>
