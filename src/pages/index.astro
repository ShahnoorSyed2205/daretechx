---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTABand from "../components/CTABand.astro";
import ShowcaseHero from "../components/ShowcaseHero.astro";
import { SERVICES, INDUSTRIES } from "../consts";

const reasons = [
	{
		title: "Embedded, not remote-and-gone.",
		description:
			"You work directly with the engineers doing the build. No account managers in between.",
	},
	{
		title: "Security engineered in from day one.",
		description: "Not bolted on after launch.",
	},
	{
		title: "Global bench, US delivery.",
		description:
			"A worldwide engineering team behind a local point of contact.",
	},
	{
		title: "Outcomes you can measure.",
		description: "We tie delivery to your metrics, not to a timesheet.",
	},
];
---

<Layout
	title="DareTechX | Forward Deployed AI Engineering & Software, Maryland"
	description="DareTechX builds, deploys, and secures AI and software for US businesses. Forward deployed engineering that gets AI into production. Based in Maryland, DC metro."
>
	<ShowcaseHero
		badge="Global Technology Solutions"
		title="Build. Deploy. Secure."
		highlight="AI that actually ships."
		description="We are the US engineering team that gets artificial intelligence out of the demo and into production. Custom software, applied AI, and security, delivered by engineers embedded in your business."
		primaryCta={{ href: "/contact", label: "Book a Consultation" }}
		secondaryCta={{ href: "/services", label: "Explore Services" }}
		keywords={["AI", "Software", "Automation", "Digital Transformation"]}
	/>

	<section class="bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-3xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">The Problem</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Most AI projects never make it to production.
				</h2>
				<p class="mt-5 text-lg leading-relaxed text-slate-400">
					The models are ready. The deployment is where it breaks. Enterprise teams pilot
					AI, see a promising demo, then stall against legacy systems, messy data, and
					compliance rules. Nine out of ten AI pilots deliver no measurable business
					impact, and the reason is almost never the model. It is the last mile. That
					last mile is what we own.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-slate-900 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">What We Do</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					One team, from first line of code to live in production.
				</h2>
			</div>

			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{SERVICES.map((service) => <ServiceCard service={service} />)}
			</div>
		</div>
	</section>

	<section class="bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Flagship</p>
					<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
						Forward deployed engineering, without the Palantir price tag.
					</h2>
					<p class="mt-5 text-lg leading-relaxed text-slate-400">
						The biggest names in tech now embed engineers directly inside their clients
						to make AI work. That model was built for Fortune 500 budgets. We bring the
						same approach to the businesses that need it just as badly and cannot spend
						half a million dollars per engineer to get it. Our engineers sit with your
						team, learn your systems, and leave you with AI that runs.
					</p>
					<a
						href="/services/forward-deployed-engineering"
						class="mt-8 inline-block rounded-lg bg-violet-500 px-6 py-3 text-base font-semibold text-slate-950 transition hover:bg-violet-400"
					>
						See how forward deployment works
					</a>
				</div>
				<div class="rounded-2xl border border-white/10 bg-slate-900 p-8 text-slate-300">
					<p class="text-5xl font-extrabold tracking-tight text-white">9/10</p>
					<p class="mt-2 text-lg text-slate-400">AI pilots never make it to production.</p>
					<div class="mt-6 space-y-3 text-sm">
						<p class="rounded-lg border border-white/10 bg-white/5 px-4 py-3">
							<span class="font-semibold text-white">The gap is not the model.</span> It is the last mile: legacy systems, messy data, compliance.
						</p>
						<p class="rounded-lg border border-white/10 bg-white/5 px-4 py-3">
							<span class="font-semibold text-white">We close that gap.</span> Embedded engineers, production code, measurable outcomes.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-slate-900 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Why DareTechX</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Built to deliver, not to bill hours.
				</h2>
			</div>

			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{
					reasons.map((reason) => (
						<div class="rounded-2xl border border-white/10 bg-slate-950/80 p-6 shadow-sm shadow-black/20">
							<h3 class="text-lg font-semibold text-white">{reason.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{reason.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-slate-950 py-20 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Industries</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Depth where it counts.
				</h2>
			</div>

			<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					INDUSTRIES.map((industry) => (
						<a
							href={industry.href}
							class="group rounded-2xl border border-white/10 bg-slate-900 p-6 transition hover:border-violet-500/50 hover:bg-slate-950 hover:shadow-md"
						>
							<h3 class="text-lg font-semibold text-white">{industry.name}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{industry.blurb}</p>
							<span class="mt-3 inline-block text-sm font-semibold text-violet-400">Learn more →</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<CTABand
		title="Have a project that keeps stalling? Let's get it shipped."
		subtitle="Tell us where you are stuck. We will tell you how we would get it live. Based in Lanham, MD, working with clients across the country."
		primaryLabel="Book a Consultation"
		showPhone={true}
	/>
</Layout>