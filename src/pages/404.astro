---
import Layout from "../layouts/Layout.astro";
import { PHONE_DISPLAY, PHONE_TEL } from "../consts";
---

<Layout title="Page Not Found" description="The page you are looking for could not be found.">
	<section class="bg-slate-950">
		<div class="mx-auto max-w-3xl px-4 py-28 text-center sm:px-6 md:py-36">
			<p class="text-6xl font-extrabold text-violet-400">404</p>
			<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white">
				Page not found
			</h1>
			<p class="mx-auto mt-4 max-w-md text-lg text-slate-300">
				The page you are looking for doesn't exist or has been moved.
			</p>
			<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
				<a
					href="/"
					class="rounded-lg bg-violet-500 px-6 py-3 text-base font-semibold text-slate-950 transition hover:bg-violet-400"
				>
					Back to Home
				</a>
				<a
					href={`tel:${PHONE_TEL}`}
					class="rounded-lg border border-white/20 px-6 py-3 text-base font-semibold text-white transition hover:bg-white/10"
				>
					Call {PHONE_DISPLAY}
				</a>
			</div>
		</div>
	</section>
</Layout>
