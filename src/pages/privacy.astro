---
import Layout from "../layouts/Layout.astro";
import { SITE_NAME, US_ADDRESS, EMAIL } from "../consts";

const updated = "Effective Date: January 1, 2026";
---

<Layout title="Privacy Policy" description={`Privacy policy for ${SITE_NAME}.`}>
	<section class="bg-slate-950">
		<div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 md:py-20">
			<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Legal</p>
			<h1 class="mt-3 text-4xl font-extrabold tracking-tight text-white">Privacy Policy</h1>
			<p class="mt-3 text-sm text-slate-400">{updated}</p>
		</div>
	</section>

	<section class="bg-slate-950 py-16 md:py-20">
		<div class="mx-auto max-w-3xl space-y-8 px-4 text-slate-400 sm:px-6">
			<div>
				<h2 class="text-xl font-semibold text-white">1. Introduction</h2>
				<p class="mt-3 leading-relaxed">
					{SITE_NAME} ("we", "us", or "our") respects your privacy. This Privacy Policy
					explains what information we collect when you visit our website and how we use,
					share, and protect it.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-semibold text-white">2. Information We Collect</h2>
				<p class="mt-3 leading-relaxed">
					We may collect information you voluntarily provide to us, such as your name,
					email address, phone number, and the contents of any message you send us through
					our contact form or by other means. We may also collect basic technical
					information automatically, such as your browser type, device type, and pages
					visited, to help us improve our website.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-semibold text-white">3. How We Use Your Information</h2>
				<p class="mt-3 leading-relaxed">
					We use the information we collect to respond to your inquiries, provide our
					services, improve our website, and comply with legal obligations. We do not sell
					your personal information to third parties.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-semibold text-white">4. Contact Form</h2>
				<p class="mt-3 leading-relaxed">
					Messages submitted through our contact form are processed by a third-party form
					service provider (Web3Forms) in order to deliver your message to us. By
					submitting the form, you consent to your message being transmitted to us through
					this service. We recommend you avoid including highly sensitive personal
					information in your message.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-semibold text-white">5. Data Security</h2>
				<p class="mt-3 leading-relaxed">
					We take reasonable measures to protect the information we collect from loss,
					misuse, and unauthorized access. However, no method of transmission over the
					internet or electronic storage is completely secure.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-semibold text-white">6. Your Rights</h2>
				<p class="mt-3 leading-relaxed">
					You may request access to, correction of, or deletion of the personal
					information we hold about you by contacting us using the details below.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-semibold text-white">7. Contact Us</h2>
				<p class="mt-3 leading-relaxed">
					If you have any questions about this Privacy Policy, please contact us at:
				</p>
				<p class="mt-3">
					{SITE_NAME}<br />
					{US_ADDRESS.line}<br />
					Email: <a href={`mailto:${EMAIL}`} class="text-violet-400 hover:underline">{EMAIL}</a>
				</p>
			</div>
		</div>
	</section>
</Layout>
