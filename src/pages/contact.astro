---
import Layout from "../layouts/Layout.astro";
import DateTimePicker from "../components/DateTimePicker.astro";
import {
	SITE_NAME,
	PHONE_DISPLAY,
	PHONE_TEL,
	EMAIL,
	US_ADDRESS,
	BUSINESS_HOURS,
	SERVICES,
} from "../consts";

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: SITE_NAME,
	url: "https://daretechx.com/contact",
	telephone: PHONE_TEL,
	email: EMAIL,
	address: {
		"@type": "PostalAddress",
		streetAddress: US_ADDRESS.street,
		addressLocality: US_ADDRESS.city,
		addressRegion: US_ADDRESS.state,
		postalCode: US_ADDRESS.zip,
		addressCountry: US_ADDRESS.country,
	},
	geo: {
		"@type": "GeoCoordinates",
		latitude: 38.7079,
		longitude: -77.003,
	},
	openingHours: "Mo-Fr 09:00-18:00",
	areaServed: "US",
	parentOrganization: {
		"@type": "Organization",
		name: SITE_NAME,
		url: "https://daretechx.com",
	},
};

const details = [
	{
		label: "Phone",
		value: PHONE_DISPLAY,
		href: `tel:${PHONE_TEL}`,
		icon: "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z",
	},
	{
		label: "Email",
		value: EMAIL,
		href: `mailto:${EMAIL}`,
		icon: "M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75",
	},
	{
		label: "US Office",
		value: US_ADDRESS.line,
		icon: "M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z",
	},
	{
		label: "Hours",
		value: BUSINESS_HOURS,
		icon: "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z",
	},
];

const serviceOptions = [...SERVICES.map((s) => s.title), "Not sure yet"];

const mapSrc =
	"https://maps.google.com/maps?q=7375%20Executive%20Pl%20Suite%20400%2C%20Lanham%2C%20MD%2020706&t=&z=14&ie=UTF8&iwloc=&output=embed";
---

<Layout
	title="Contact DareTechX | Book a Consultation | Maryland, USA"
	description="Tell us what you need and we will respond promptly. DareTechX, based in Lanham, MD, working with clients across the US. Call (240) 424-1444."
	schema={[localBusinessSchema]}
>
	<section class="bg-slate-950">
		<div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 md:py-24">
			<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Contact</p>
			<h1 class="mt-3 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
				Let's build something that ships.
			</h1>
			<p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
				Tell us where you are stuck and what you need. We will respond promptly with how
				we would approach it. No pressure, no runaround.
			</p>
		</div>
	</section>

	<section class="bg-slate-950 py-16 md:py-20">
		<div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-5">
			<div class="lg:col-span-2">
				<h2 class="text-2xl font-bold tracking-tight text-white">Contact Details</h2>
				<ul class="mt-8 space-y-6">
					{
						details.map((item) => (
							<li class="flex items-start gap-4">
								<span
									class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-white/5 text-violet-400"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										fill="none"
										viewBox="0 0 24 24"
										stroke-width="1.8"
										stroke="currentColor"
										class="size-5"
										aria-hidden="true"
									>
										<path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
									</svg>
								</span>
								<div>
									<p class="text-sm font-semibold uppercase tracking-wider text-slate-400">
										{item.label}
									</p>
									{item.href ? (
										<a href={item.href} class="mt-1 block text-lg font-medium text-white hover:text-violet-400">
											{item.value}
										</a>
									) : (
										<p class="mt-1 text-lg font-medium text-white">{item.value}</p>
									)}
								</div>
							</li>
						))
					}
				</ul>
			</div>

			<div class="lg:col-span-3">
				<form id="contact-form" class="rounded-2xl border border-white/10 bg-slate-900 p-6 sm:p-8">
					<h2 class="text-2xl font-bold tracking-tight text-white">Send a Message or Book a Call</h2>
					<p class="mt-2 text-sm text-slate-400">
						Fields marked <span class="font-semibold text-violet-400">*</span> are required.
					</p>

					<div class="mt-6 grid gap-5 sm:grid-cols-2">
						<div>
							<label for="name" class="block text-sm font-medium text-slate-300">Name *</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								autocomplete="name"
								placeholder="Your full name"
								class="mt-1.5 w-full rounded-lg border border-white/15 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/30"
							/>
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-slate-300">Work email *</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								autocomplete="email"
								placeholder="you@company.com"
								class="mt-1.5 w-full rounded-lg border border-white/15 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/30"
							/>
						</div>
					</div>

					<div class="mt-5">
						<label for="company" class="block text-sm font-medium text-slate-300">Company</label>
						<input
							type="text"
							id="company"
							name="company"
							autocomplete="organization"
							placeholder="Your company"
							class="mt-1.5 w-full rounded-lg border border-white/15 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/30"
						/>
					</div>

					<div class="mt-5">
						<label for="service" class="block text-sm font-medium text-slate-300">Service of interest</label>
						<select
							id="service"
							name="service"
							class="mt-1.5 w-full rounded-lg border border-white/15 bg-slate-950 px-3.5 py-2.5 text-sm text-white outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/30"
						>
							{serviceOptions.map((option) => <option value={option}>{option}</option>)}
						</select>
					</div>

					<div class="mt-5">
						<p class="text-sm font-medium text-slate-300">
							Preferred call slot
						</p>
						<p class="mt-0.5 text-xs text-slate-500">
							Want to talk it through? Pick a date and time and we will call you.
						</p>
						<DateTimePicker class="mt-3" />
					</div>

					<div class="mt-5">
						<label for="message" class="block text-sm font-medium text-slate-300">Message *</label>
						<textarea
							id="message"
							name="message"
							rows="5"
							required
							placeholder="Tell us where you are stuck and what you need. Also include the mobile number or email you would like us to reach you on."
							class="mt-1.5 w-full rounded-lg border border-white/15 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/30"
						></textarea>
					</div>

					<div class="h-captcha mt-5" data-captcha="true"></div>

					<div
						id="form-status"
						class="mt-5 hidden rounded-lg border border-white/15 bg-slate-950 px-4 py-3 text-sm text-slate-400"
						role="status"
					></div>

					<button
						type="submit"
						class="mt-6 w-full rounded-lg bg-violet-500 px-6 py-3 text-base font-semibold text-slate-950 transition hover:bg-violet-400 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
					>
						Send message
					</button>
				</form>
			</div>
		</div>
	</section>

	<section class="bg-slate-900 py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-widest text-violet-400">Find Us</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Our US office in Lanham, MD
				</h2>
			</div>
			<div class="mt-8 overflow-hidden rounded-2xl border border-white/10 shadow-sm">
				<iframe
					src={mapSrc}
					title="Map showing the DareTechX US office at 7375 Executive Pl Suite 400, Lanham, MD"
					class="h-[400px] w-full border-0"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</div>
		</div>
	</section>
</Layout>

<script>
	import { WEB3FORMS_ACCESS_KEY } from "../consts";

	const form = document.getElementById("contact-form") as HTMLFormElement;
	const statusEl = document.getElementById("form-status") as HTMLElement;
	const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;

	function showStatus(message: string, isError: boolean) {
		statusEl.textContent = message;
		statusEl.classList.remove("hidden");
		statusEl.classList.toggle("border-red-500/40", isError);
		statusEl.classList.toggle("text-red-400", isError);
		statusEl.classList.toggle("border-green-500/40", !isError);
		statusEl.classList.toggle("text-green-400", !isError);
	}

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		const hCaptcha = (
			form.querySelector('textarea[name="h-captcha-response"]') as HTMLTextAreaElement | null
		)?.value;

		if (!hCaptcha) {
			showStatus("Please complete the captcha before sending.", true);
			return;
		}

		button.disabled = true;
		button.textContent = "Sending...";

		try {
			const data = new FormData(form);
			data.append("access_key", WEB3FORMS_ACCESS_KEY);
			data.append(
				"subject",
				`Website inquiry — ${(data.get("service") as string) || "General"}`
			);
			data.append("from_name", "DareTechX Website");

			const response = await fetch("https://api.web3forms.com/submit", {
				method: "POST",
				body: data,
			});

			if (!response.ok) {
				throw new Error("Request failed");
			}

			const result = await response.json();
			if (result.success) {
				showStatus("Thanks for your message! We will get back to you within one business day.", false);
				form.reset();
			} else {
				showStatus("Something went wrong. Please try again or contact us by phone.", true);
			}
		} catch {
			showStatus("Something went wrong. Please try again or contact us by phone.", true);
		} finally {
			button.disabled = false;
			button.textContent = "Send message";
		}
	});
</script>

<script is:inline src="https://web3forms.com/client/script.js" async defer></script>